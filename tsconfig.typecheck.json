{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // Source plus the type-level tests. The runtime *.test.ts suites are left out
  // deliberately: they predate this config and lean on loosely typed mocks.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.bench.ts", "**/*.test.ts"]
}
